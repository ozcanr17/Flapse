        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가려진 프로젝트와 타임랩스를 열기 위해 Face ID를 사용합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Face ID é usado para abrir projetos e timelapses ocultos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID используется для открытия скрытых проектов и таймлапсов."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gizlenen proje ve timelapse'leri açmak için Face ID kullanılır."
