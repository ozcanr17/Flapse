          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua posizione è utilizzata per etichettare le tue catture con il luogo in cui sono state scattate."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je locatie wordt gebruikt om je opnames te taggen met de plaats waar ze zijn gemaakt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้ตำแหน่งของคุณเพื่อปักหมุดภาพที่คุณถ่าย"
          }
        },
        "id" : {
          "stringUnit" : {
