          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID 用於開啟隱藏的項目和縮時影片。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID è utilizzato per aprire progetti nascosti e timelapse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID wordt gebruikt om verborgen projecten en timelapses te openen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้ Face ID เพื่อเปิดโปรเจกต์ที่ซ่อนอยู่และไทม์แลปส์"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
