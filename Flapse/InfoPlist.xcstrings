        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "छिपे हुए प्रोजेक्ट और टाइमलैप्स खोलने के लिए Face ID का उपयोग किया जाता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非表示のプロジェクトとタイムラプスを開くためにFace IDを使用します。"
