    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يلزم الوصول إلى الكاميرا لالتقاط صور تقدّمك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kamerazugriff wird benötigt, um deine Fortschrittsfotos aufzunehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera access is needed to take your progress photos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita acceso a la cámara para tomar tus fotos de progreso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès à la caméra est nécessaire pour prendre tes photos de progression."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी प्रगति की फ़ोटो लेने के लिए कैमरा एक्सेस चाहिए।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "進捗写真を撮影するためにカメラへのアクセスが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "진행 사진을 찍으려면 카메라 접근이 필요합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso à câmera é necessário para tirar suas fotos de progresso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к камере нужен, чтобы снимать фото вашего прогресса."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelişim fotoğraflarını çekmek için kameraya erişim gerekir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要访问相机来拍摄你的进度照片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要相機存取權以拍攝您的進度照片。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È necessario l'accesso alla fotocamera per scattare le foto del progresso."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera-toegang is nodig om je voortgangsfoto's te maken."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้องการเข้าถึงกล้องเพื่อถ่ายภาพความคืบหน้าของคุณ"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akses kamera diperlukan untuk mengambil foto kemajuan Anda."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cần quyền truy cập camera để chụp ảnh tiến trình của bạn."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kameratillgång behövs för att ta dina framstegsfoton."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostęp do aparatu jest potrzebny, aby robić zdjęcia postępów."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستخدم Face ID لفتح المشاريع ومقاطع التايم لابس المخفية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID wird verwendet, um ausgeblendete Projekte und Timelapses zu öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID is used to open hidden projects and timelapses."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID se usa para abrir proyectos y timelapses ocultos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID est utilisé pour ouvrir les projets et timelapses masqués."
