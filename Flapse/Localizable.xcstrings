    "Günde bir kare çek; zamanla değişimin\nkendiliğinden bir timelapse'e dönüşsün." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التقط صورة كل يوم؛ ومع الوقت يتحول\nتغيّرك تلقائيًا إلى فيديو تايم لابس."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm ein Bild pro Tag auf; mit der Zeit wird\ndeine Veränderung von selbst zum Zeitraffer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take one frame a day; over time your progress\nturns into a timelapse on its own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toma una foto al día; con el tiempo tu progreso\nse convierte solo en un timelapse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prends une photo par jour ; avec le temps,\nton évolution devient un timelapse toute seule."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रोज़ एक फ़ोटो लें; समय के साथ आपका बदलाव\nअपने आप टाइमलैप्स बन जाएगा।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1日1枚撮るだけで、変化が\n自然とタイムラプスになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루 한 장씩 찍으면 시간이 지나\n변화가 저절로 타임랩스가 됩니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tire uma foto por dia; com o tempo, sua evolução\nvira um timelapse sozinha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Снимайте по кадру в день — со временем\nперемены сами сложатся в таймлапс."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天拍一张；随着时间推移，\n你的变化会自然变成一段延时视频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天拍一幀時間的進展；\n自行變成縮時拍攝。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prendi un fotogramma al giorno; nel tempo i tuoi progressi\nsi trasforma in un timelapse da solo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neem één beeld per dag; na verloop van tijd wordt je voortgang vanzelf een timelapse."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ่ายกรอบหนึ่งต่อวัน; เมื่อเวลาผ่านไป ความคืบหน้าของคุณจะกลายเป็นวิดีโอไทม์แลปส์เอง"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambil satu bingkai setiap hari; seiring waktu, kemajuan Anda berubah menjadi time-lapse sendiri."
