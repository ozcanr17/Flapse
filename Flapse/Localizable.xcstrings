          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dagelijks, om de dag of wekelijks — krijg een herinnering wanneer het tijd is"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รายวัน, วันเว้นวัน หรือรายสัปดาห์ — รับการแจ้งเตือนเมื่อถึงเวลา"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harian, setiap dua hari sekali, atau mingguan — dapatkan pengingat saat waktunya"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hàng ngày, cách ngày hoặc hàng tuần — nhận nhắc nhở khi đến thời gian"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
