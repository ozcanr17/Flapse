    "Sana geri dönebilmem için e-postanı bırakabilirsin. Mesajınla birlikte yalnızca uygulama sürümü, iOS sürümü ve cihaz modeli gönderilir." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اترك بريدك للرد عليك. يُرسل مع الرسالة إصدار التطبيق وإصدار iOS وطراز الجهاز فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinterlasse deine E-Mail für eine Antwort. Mit der Nachricht werden nur App-Version, iOS-Version und Gerätemodell gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave your email so I can reply. Only your app version, iOS version and device model are sent with the message."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja tu correo para poder responderte. Solo se envían la versión de la app, la de iOS y el modelo del dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez votre e-mail pour une réponse. Seules la version de l’app, la version d’iOS et le modèle sont envoyés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उत्तर के लिए ईमेल छोड़ें। संदेश के साथ केवल ऐप संस्करण, iOS संस्करण और डिवाइस मॉडल भेजा जाता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "返信用にメールを残せます。送信されるのはアプリ版・iOS版・端末モデルのみです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "답장을 위해 이메일을 남길 수 있습니다. 메시지와 함께 앱 버전, iOS 버전, 기기 모델만 전송됩니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe seu e-mail para eu responder. Só são enviados versão do app, versão do iOS e modelo do dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставьте эл. почту для ответа. Отправляются только версия приложения, версия iOS и модель устройства."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sana geri dönebilmem için e-postanı bırakabilirsin. Mesajınla birlikte yalnızca uygulama sürümü, iOS sürümü ve cihaz modeli gönderilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可留下邮箱以便回复。随消息仅发送应用版本、iOS 版本和设备型号。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留下您的電子郵件，好讓我回覆。訊息中僅發送您的應用程式版本、iOS 版本和裝置型號。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia la tua email così posso risponderti. Con il messaggio vengono inviati solo la versione dell'app, la versione iOS e il modello del dispositivo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat je e-mailadres achter zodat ik kan reageren. Alleen je app-versie, iOS-versie en apparaattype worden met het bericht verzonden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฝากอีเมลของคุณเพื่อให้ฉันสามารถตอบกลับได้ ข้อความจะถูกส่งพร้อมเฉพาะเวอร์ชันแอปของคุณ เวอร์ชัน iOS และรุ่นอุปกรณ์เท่านั้น"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinggalkan email Anda agar saya bisa membalas. Hanya versi aplikasi Anda, versi iOS, dan model perangkat yang dikirim dengan pesan."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy để lại email của bạn để tôi có thể trả lời. Chỉ phiên bản ứng dụng, phiên bản iOS và mẫu thiết bị của bạn được gửi kèm với tin nhắn."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lämna din e-post så att jag kan svara. Endast din appversion, iOS-version och enhetsmodell skickas med meddelandet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podaj swój e-mail, abym mógł odpowiedzieć. Wiadomość zawiera tylko wersję Twojej aplikacji, wersję iOS i model urządzenia."
          }
        }
      }
    },
