    "Silinen fotoğraflar 30 gün saklanır, sonra kalıcı olarak silinir." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم الاحتفاظ بالصور المحذوفة لمدة 30 يومًا، ثم تُحذف نهائيًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelöschte Fotos werden 30 Tage lang aufbewahrt und dann endgültig gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleted photos are kept for 30 days, then permanently deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos eliminadas se conservan durante 30 días y después se borran permanentemente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos supprimées sont conservées pendant 30 jours, puis supprimées définitivement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हटाई गई फ़ोटो 30 दिनों तक रखी जाती हैं, फिर स्थायी रूप से हटा दी जाती हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除した写真は30日間保存された後、完全に削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "삭제된 사진은 30일 동안 보관된 후 영구 삭제됩니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fotos eliminadas são mantidas durante 30 dias e depois apagadas permanentemente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалённые фотографии хранятся 30 дней, после чего удаляются навсегда."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已删除的照片会保留 30 天，之后将永久删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已刪除的照片將保留 30 天，然後永久刪除。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le foto eliminate vengono conservate per 30 giorni, quindi eliminate definitivamente."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijderde foto's worden 30 dagen bewaard en vervolgens permanent verwijderd."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รูปภาพที่ถูกลบจะเก็บไว้ 30 วัน จากนั้นจะถูกลบถาวร"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto yang dihapus disimpan selama 30 hari, kemudian dihapus secara permanen."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các ảnh đã xóa được giữ trong 30 ngày, sau đó bị xóa vĩnh viễn."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borttagna foton sparas i 30 dagar, sedan raderas de permanent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunięte zdjęcia są przechowywane przez 30 dni, a następnie trwale usuwane."
          }
        }
      }
    },
