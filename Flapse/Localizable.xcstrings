    "Bildiriminiz geliştirme ekibine ulaştı ve değerlendirmeye alındı. Katkınız için teşekkür ederiz." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وصل تقريرك إلى فريق التطوير وستتم مراجعته. شكرًا لمساهمتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Meldung hat das Entwicklungsteam erreicht und wird geprüft. Vielen Dank für Ihren Beitrag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your report has reached the development team and will be reviewed. Thank you for your contribution."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu informe ha llegado al equipo de desarrollo y será revisado. Gracias por tu contribución."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre signalement est parvenu à l’équipe de développement et sera examiné. Merci de votre contribution."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी रिपोर्ट विकास टीम तक पहुँच गई है और इसकी समीक्षा की जाएगी। आपके योगदान के लिए धन्यवाद।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ご報告は開発チームに届き、確認いたします。ご協力ありがとうございます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보내주신 내용이 개발팀에 전달되어 검토될 예정입니다. 참여해 주셔서 감사합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu relato chegou à equipe de desenvolvimento e será analisado. Obrigado pela contribuição."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваше сообщение получено командой разработки и будет рассмотрено. Благодарим за вклад."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildiriminiz geliştirme ekibine ulaştı ve değerlendirmeye alındı. Katkınız için teşekkür ederiz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的反馈已送达开发团队并将被审阅。感谢您的贡献。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的報告已送達開發團隊，我們將對其進行審核。感謝您的貢獻。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua segnalazione ha raggiunto il team di sviluppo e verrà esaminata. Grazie per il tuo contributo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uw rapport is bij het ontwikkelingsteam binnengekomen en zal worden beoordeeld. Dank u voor uw bijdrage."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รายงานของคุณได้ถูกส่งไปยังทีมพัฒนาและจะได้รับการตรวจสอบ ขอบคุณสำหรับการมีส่วนร่วมของคุณ"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laporan Anda telah diterima oleh tim pengembang dan akan ditinjau. Terima kasih atas kontribusi Anda."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Báo cáo của bạn đã được gửi đến đội ngũ phát triển và sẽ được xem xét. Cảm ơn bạn đã đóng góp."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din rapport har nått utvecklingsteamet och kommer att granskas. Tack för ditt bidrag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje zgłoszenie dotarło do zespołu deweloperskiego i zostanie przejrzane. Dziękujemy za Twój wkład."
          }
        }
      }
    },
