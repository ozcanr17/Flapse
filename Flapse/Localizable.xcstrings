        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस टाइमलैप्स को हाल ही में हटाए गए में ले जाएँ? यह 7 दिनों के बाद स्थायी रूप से हट जाएगा।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このタイムラプスを「最近削除した項目」に移動しますか？7日後に完全に削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 타임랩스를 최근 삭제된 항목으로 이동할까요? 7일 후 영구적으로 삭제됩니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mover este timelapse para Apagados recentemente? Ele será apagado permanentemente após 7 dias."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переместить этот таймлапс в «Недавно удалённые»? Через 7 дней он будет удалён навсегда."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要将此延时视频移到“最近删除”吗？7 天后将被永久删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將此縮時攝影移至「最近刪除」嗎？ 7 天後將永久刪除。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spostare questo timelapse in Eliminati di recente? Verrà eliminato definitivamente dopo 7 giorni."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit timelapse verplaatsen naar Recent Verwijderd? Het wordt permanent verwijderd na 7 dagen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ย้ายไทม์แลปส์นี้ไปยัง 'เพิ่งลบ'? มันจะถูกลบอย่างถาวรหลังจาก 7 วัน"
