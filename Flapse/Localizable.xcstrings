    "Şu anda doğrudan gönderilemedi (iCloud oturumu veya bağlantı gerekiyor). Bulguyu e-posta olarak iletebilirsin." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر الإرسال مباشرة الآن (يلزم تسجيل iCloud أو اتصال). يمكنك الإرسال بالبريد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direktes Senden ist gerade nicht möglich (iCloud-Anmeldung oder Verbindung nötig). Du kannst es per E-Mail senden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn’t send directly right now (needs iCloud sign-in or a connection). You can send it by email instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo enviar directamente (requiere iCloud o conexión). Puedes enviarlo por correo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoi direct impossible (connexion ou compte iCloud requis). Vous pouvez l’envoyer par e-mail."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी सीधे नहीं भेजा जा सका (iCloud साइन-इन या कनेक्शन चाहिए)। ईमेल से भेज सकते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今は直接送信できません（iCloudサインインまたは接続が必要）。メールで送信できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 직접 보낼 수 없습니다(iCloud 로그인 또는 연결 필요). 이메일로 보낼 수 있습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível enviar direto (precisa de iCloud ou conexão). Você pode enviar por e-mail."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось отправить напрямую (нужен вход в iCloud или соединение). Можно отправить по почте."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şu anda doğrudan gönderilemedi (iCloud oturumu veya bağlantı gerekiyor). Bulguyu e-posta olarak iletebilirsin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前无法直接发送（需登录 iCloud 或联网）。可改用邮件发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在無法直接發送（需要 iCloud 登入或連接）。您可以透過電子郵件發送。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile inviare direttamente in questo momento (è necessario accesso a iCloud o connessione). Puoi invece inviarlo via email."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kon momenteel niet direct verzenden (vereist iCloud-aanmelding of een verbinding). Je kunt het in plaats daarvan per e-mail verzenden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่สามารถส่งโดยตรงได้ตอนนี้ (ต้องเข้าสู่ระบบ iCloud หรือเชื่อมต่อ) คุณสามารถส่งทางอีเมลแทนได้"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat mengirim langsung sekarang (memerlukan masuk iCloud atau koneksi). Anda bisa mengirimnya melalui email sebagai gantinya."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể gửi trực tiếp ngay bây giờ (cần đăng nhập iCloud hoặc kết nối). Bạn có thể gửi qua email thay vào đó."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunde inte skickas direkt just nu (kräver iCloud-inloggning eller en anslutning). Du kan skicka den via e-post istället."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można wysłać bezpośrednio w tym momencie (wymagane zalogowanie do iCloud lub połączenie). Możesz wysłać to zamiast tego e-mailem."
          }
        }
      }
    },
