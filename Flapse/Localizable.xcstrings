            "value" : "اسحب لتوسيط الهدف؛ يمكنك محاذاة كل صورة على حدة"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe, um das Motiv zu zentrieren; jedes Bild lässt sich einzeln ausrichten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag to center the subject; you can align every frame individually"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra para centrar el sujeto; puedes alinear cada foto por separado"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fais glisser pour centrer le sujet ; chaque photo peut être alignée séparément"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विषय को बीच में लाने के लिए खींचें; हर फ़ोटो अलग से संरेखित कर सकते हैं"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグして被写体を中央に。写真ごとに個別調整できます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드래그해 피사체를 가운데로. 사진마다 개별 정렬할 수 있어요"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste para centralizar o objeto; você pode alinhar cada foto separadamente"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетащите, чтобы отцентрировать объект; каждый кадр можно выровнять отдельно"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动以居中主体；每张照片都可单独对齐"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖曳使主題居中；您可以單獨對齊每個框架"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina per centrare il soggetto; puoi allineare ogni fotogramma individualmente"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep om het onderwerp te centreren; je kunt elk frame afzonderlijk uitlijnen"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลากเพื่อจัดศูนย์วัตถุ; คุณสามารถจัดแนวแต่ละเฟรมได้แยกกัน"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seret untuk memusatkan subjek; Anda dapat menyelaraskan setiap bingkai secara individu"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kéo để căn giữa chủ thể; bạn có thể căn chỉnh từng khung hình riêng lẻ"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra för att centrera motivet; du kan justera varje bildruta individuellt"
          }
