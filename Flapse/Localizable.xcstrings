    "Silinen projeler 30 gün saklanır, sonra kalıcı olarak silinir. iCloud yedekleme açıksa bu süre boyunca iCloud'da da saklanırlar." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحفظ المشاريع المحذوفة لمدة 30 يومًا ثم تُحذف نهائيًا. وإذا كان نسخ iCloud الاحتياطي مفعّلًا، تُحفظ أيضًا في iCloud خلال هذه المدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelöschte Projekte werden 30 Tage aufbewahrt und dann endgültig gelöscht. Bei aktivem iCloud-Backup bleiben sie in dieser Zeit auch in iCloud erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleted projects are kept for 30 days, then removed permanently. If iCloud backup is on, they are also kept in iCloud during this period."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los proyectos eliminados se conservan 30 días y luego se borran permanentemente. Con la copia de iCloud activada, también se conservan en iCloud durante ese período."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les projets supprimés sont conservés 30 jours puis effacés définitivement. Si la sauvegarde iCloud est active, ils restent aussi dans iCloud pendant cette période."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हटाए गए प्रोजेक्ट 30 दिन रखे जाते हैं, फिर हमेशा के लिए हट जाते हैं। iCloud बैकअप चालू होने पर इस अवधि में वे iCloud में भी रहते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除したプロジェクトは30日間保管され、その後完全に削除されます。iCloud バックアップが有効なら、この期間中は iCloud にも保管されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "삭제된 프로젝트는 30일간 보관된 뒤 영구 삭제됩니다. iCloud 백업이 켜져 있으면 이 기간 동안 iCloud에도 보관됩니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projetos apagados são mantidos por 30 dias e depois excluídos permanentemente. Com o backup do iCloud ativo, também ficam no iCloud durante esse período."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалённые проекты хранятся 30 дней, затем удаляются навсегда. При включённой резервной копии iCloud они также хранятся в iCloud в этот период."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已删除的项目会保留 30 天，之后永久删除。若开启 iCloud 备份，此期间也会保留在 iCloud 中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已刪除的項目將保留 30 天，然後永久刪除。如果 iCloud 備份已開啟，在此期間它們也會保留在 iCloud 中。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I progetti eliminati vengono conservati per 30 giorni, quindi rimossi definitivamente. Se il backup di iCloud è attivo, verranno conservati anche in iCloud durante questo periodo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijderde projecten worden 30 dagen bewaard en daarna permanent verwijderd. Als iCloud-back-up is ingeschakeld, worden ze gedurende deze periode ook in iCloud bewaard."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โปรเจกต์ที่ถูกลบจะเก็บไว้ 30 วัน จากนั้นจะถูกลบถาวร หากเปิดการสำรองข้อมูล iCloud โปรเจกต์เหล่านี้จะถูกเก็บไว้ใน iCloud ในช่วงเวลานี้ด้วย"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proyek yang dihapus disimpan selama 30 hari, kemudian dihapus secara permanen. Jika cadangan iCloud aktif, proyek tersebut juga disimpan di iCloud selama periode ini."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các dự án đã xóa được giữ trong 30 ngày, sau đó sẽ bị xóa vĩnh viễn. Nếu sao lưu iCloud được bật, chúng cũng được giữ trong iCloud trong thời gian này."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borttagna projekt sparas i 30 dagar, sedan tas de bort permanent. Om iCloud-säkerhetskopiering är på, sparas de även i iCloud under denna period."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunięte projekty są przechowywane przez 30 dni, a następnie trwale usuwane. Jeśli kopia zapasowa iCloud jest włączona, są one również przechowywane w iCloud w tym okresie."
          }
        }
      }
    },
    "Silinen timelapse'ler 7 gün saklanır, sonra kalıcı olarak silinir." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُحتفظ بالتايم لابس المحذوف لمدة 7 أيام، ثم يُحذف نهائيًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelöschte Timelapses werden 7 Tage aufbewahrt und dann endgültig gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleted timelapses are kept for 7 days, then permanently deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los timelapses eliminados se conservan 7 días y luego se eliminan permanentemente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les timelapses supprimés sont conservés 7 jours, puis définitivement supprimés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हटाए गए टाइमलैप्स 7 दिनों तक रखे जाते हैं, फिर स्थायी रूप से हट जाते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除されたタイムラプスは7日間保持され、その後完全に削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "삭제된 타임랩스는 7일간 보관된 후 영구적으로 삭제됩니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timelapses apagados são mantidos por 7 dias e depois apagados permanentemente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалённые таймлапсы хранятся 7 дней, затем удаляются навсегда."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已删除的延时视频会保留 7 天，之后将被永久删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已刪除的縮時攝影將保留 7 天，然後永久刪除。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I timelapse eliminati vengono conservati per 7 giorni, quindi eliminati definitivamente."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijderde timelapses worden 7 dagen bewaard en daarna permanent verwijderd."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไทม์แลปส์ที่ถูกลบจะเก็บไว้ 7 วัน จากนั้นจะถูกลบถาวร"
          }
        },
        "id" : {
          "stringUnit" : {
