    "Bir projeden timelapse oluşturup \"Uygulamada sakla\" dediğinde burada birikir." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند إنشاء تايم لابس من مشروع واختيار \"الاحتفاظ في التطبيق\"، سيتجمّع هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelle einen Zeitraffer aus einem Projekt und tippe auf „In der App behalten“ – dann sammelt er sich hier."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create a timelapse from a project, tap \"Keep in app\", and it'll collect here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando crees un timelapse desde un proyecto y toques \"Conservar en la app\", se guardará aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crée un timelapse depuis un projet, touche « Garder dans l'app » et il apparaîtra ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी प्रोजेक्ट से टाइमलैप्स बनाकर \"ऐप में रखें\" पर टैप करने पर वे यहां जमा होते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロジェクトからタイムラプスを作成して「アプリ内に保存」をタップすると、ここに集まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로젝트에서 타임랩스를 만들고 \"앱에 보관\"을 누르면 여기에 모여요."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crie um timelapse em um projeto e toque em \"Manter no app\" para vê-lo aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создай таймлапс из проекта и нажми «Хранить в приложении» — он появится здесь."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在项目中生成延时视频并点按“保留在应用中”后，就会收集到这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從專案創建延時攝影，點按“保留在應用程式中”，它將收集到此處。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un timelapse da un progetto, tocca \"Conserva nell'app\" e verrà raccolto qui."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak een timelapse van een project, tik op \"Bewaren in app\", en het wordt hier verzameld."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สร้างไทม์แลปส์จากโครงการ แตะ \"เก็บไว้ในแอป\" และมันจะถูกรวบรวมที่นี่"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buat timelapse dari sebuah proyek, ketuk \"Simpan di aplikasi\", dan itu akan terkumpul di sini."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tạo một timelapse từ một dự án, chạm vào \"Giữ trong ứng dụng\", và nó sẽ được thu thập ở đây."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skapa en timelapse från ett projekt, tryck på \"Behåll i app\", och det kommer samlas här."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utwórz timelapse z projektu, stuknij „Zachowaj w aplikacji”, a zostanie on tutaj zebrany."
          }
        }
      }
    },
