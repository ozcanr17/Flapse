    "Seçilen %lld fotoğraf aynı güne taşınır; kendi saatleri korunur." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُنقل الصور المحددة البالغ عددها %lld إلى اليوم نفسه مع الاحتفاظ بأوقاتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die %lld ausgewählten Fotos werden auf denselben Tag verschoben; ihre Uhrzeiten bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The %lld selected photos move to the same day; their own times are kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las %lld fotos seleccionadas se mueven al mismo día; se mantiene su hora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les %lld photos sélectionnées sont déplacées au même jour ; leur heure est conservée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चयनित %lld फ़ोटो उसी दिन पर चली जाएँगी; उनका अपना समय बना रहेगा।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した%lld枚の写真を同じ日に移動します。時刻はそのまま保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 사진 %lld장을 같은 날짜로 옮기며, 각자의 시간은 유지됩니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As %lld fotos selecionadas vão para o mesmo dia; o horário de cada uma é mantido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбранные фото (%lld) переносятся на один день; их время сохраняется."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所选的 %lld 张照片将移到同一天，各自的时间保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 所選照片移至同一天；保留他們自己的時間。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le foto selezionate %lld vengono spostate nello stesso giorno; i loro orari vengono mantenuti."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De %lld geselecteerde foto's verplaatsen naar dezelfde dag; hun eigen tijden blijven behouden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ภาพถ่ายที่เลือก %lld ย้ายไปยังวันเดียวกัน; เวลาของแต่ละภาพยังคงอยู่ตามเดิม"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto-foto %lld yang dipilih dipindahkan ke hari yang sama; waktunya masing-masing tetap."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các ảnh được chọn %lld di chuyển đến cùng một ngày; thời gian của chúng vẫn được giữ nguyên."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De %lld valda fotona flyttas till samma dag; deras egna tider behålls."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybrane zdjęcia %lld zostaną przeniesione na ten sam dzień; ich własne czasy zostaną zachowane."
          }
        }
      }
    },
    "Seçilen %lld fotoğrafa aynı tarih ve saat uygulanır." : {
