        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chụp một khung hình mỗi ngày; theo thời gian tiến trình của bạn sẽ tự biến thành một video timelapse."
          }
        },
        "sv" : {
          "stringUnit" : {
