    "Projelerin hesabınla eşleşir; iCloud yedekleme açıkken başka bir cihazda da geri gelir." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترتبط مشاريعك بحسابك؛ ومع نسخ iCloud الاحتياطي تعود على أي جهاز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Projekte sind mit deinem Konto verknüpft; mit iCloud-Backup kommen sie auf jedem Gerät zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your projects link to your account; with iCloud backup on, they come back on any device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus proyectos se vinculan a tu cuenta; con la copia de iCloud, vuelven en cualquier dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes projets sont liés à ton compte ; avec la sauvegarde iCloud, ils reviennent sur tout appareil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके प्रोजेक्ट आपके खाते से जुड़ते हैं; iCloud बैकअप चालू होने पर किसी भी डिवाइस पर वापस आते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロジェクトはアカウントに紐づきます。iCloud バックアップが有効なら、どの端末でも復元されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로젝트는 계정에 연결됩니다. iCloud 백업이 켜져 있으면 어느 기기에서든 복원됩니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus projetos ficam ligados à sua conta; com o backup do iCloud, voltam em qualquer aparelho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проекты привязаны к вашей учётной записи; с резервной копией iCloud они вернутся на любом устройстве."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "项目与你的账户关联；开启 iCloud 备份后，可在任何设备上找回。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的專案連結到您的帳戶；開啟 iCloud 備份後，它們會在任何裝置上恢復。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi progetti si collegano al tuo account; con il backup iCloud attivo, ritornano su qualsiasi dispositivo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je projecten zijn gekoppeld aan je account; met iCloud-back-up aan, komen ze op elk apparaat terug."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โปรเจกต์ของคุณเชื่อมโยงกับบัญชีของคุณ; เมื่อเปิดการสำรองข้อมูล iCloud พวกมันจะกลับมาบนอุปกรณ์ใดก็ได้"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proyek Anda terhubung ke akun Anda; dengan cadangan iCloud aktif, mereka akan kembali di perangkat mana pun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các dự án của bạn liên kết với tài khoản của bạn; với sao lưu iCloud bật, chúng sẽ xuất hiện lại trên bất kỳ thiết bị nào."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina projekt är kopplade till ditt konto; med iCloud-säkerhetskopiering påslagen återkommer de på alla enheter."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje projekty są powiązane z Twoim kontem; jeśli włączona jest kopia zapasowa iCloud, wracają na każdym urządzeniu."
          }
        }
      }
    },
