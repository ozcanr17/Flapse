    "Günlük, gün aşırı ya da haftalık — zamanı gelince hatırlatırız" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوميًا أو يومًا بعد يوم أو أسبوعيًا — نذكّرك في الوقت المناسب"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Täglich, jeden zweiten Tag oder wöchentlich — wir erinnern dich rechtzeitig"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daily, every other day, or weekly — we remind you when it's time"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diario, cada dos días o semanal — te recordamos cuando toque"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque jour, un jour sur deux ou chaque semaine — on te le rappelle au bon moment"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रोज़, एक दिन छोड़कर या हफ़्ते में — समय आने पर याद दिलाएँगे"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎日・1日おき・毎週 — 時間になったらお知らせします"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매일, 이틀에 한 번, 매주 — 때가 되면 알려드려요"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diário, dia sim dia não ou semanal — lembramos você na hora certa"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый день, через день или раз в неделю — мы напомним вовремя"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天、隔天或每周 — 到点我们会提醒你"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天、隔天或每週 - 我們會在時間到時提醒您"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giornaliero, a giorni alterni o settimanale: ti ricordiamo quando è il momento"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dagelijks, om de dag, of wekelijks — we herinneren je wanneer het tijd is"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทุกวัน สองวันครั้ง หรือทุกสัปดาห์ — เราจะแจ้งเตือนคุณเมื่อถึงเวลา"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harian, setiap dua hari sekali, atau mingguan — kami akan mengingatkan Anda saat waktunya"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hàng ngày, cách ngày, hoặc hàng tuần — chúng tôi nhắc bạn khi đến thời gian"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dagligen, varannan dag eller veckovis — vi påminner dig när det är dags"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codziennie, co drugi dzień lub co tydzień — przypomnimy Ci, kiedy nadejdzie czas"
