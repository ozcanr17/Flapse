    "Apple ile giriş kaydın bu cihazdan kaldırılır. Projelerin ve fotoğrafların cihazında kalır." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُزال تسجيل الدخول بـ Apple من هذا الجهاز. تبقى مشاريعك وصورك على جهازك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Anmeldung mit Apple wird von diesem Gerät entfernt. Deine Projekte und Fotos bleiben auf dem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Sign in with Apple record is removed from this device. Your projects and photos stay on your device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu registro de inicio de sesión con Apple se elimina de este dispositivo. Tus proyectos y fotos permanecen en tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton enregistrement Connexion avec Apple est supprimé de cet appareil. Tes projets et photos restent sur ton appareil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका Apple साइन-इन रिकॉर्ड इस डिवाइस से हटा दिया जाएगा। आपके प्रोजेक्ट और फ़ोटो डिवाइस पर रहेंगे।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleでサインインの記録がこのデバイスから削除されます。プロジェクトと写真はデバイスに残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 로그인 기록이 이 기기에서 제거됩니다. 프로젝트와 사진은 기기에 남습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu registro de Iniciar sessão com a Apple é removido deste dispositivo. Seus projetos e fotos permanecem no dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запись входа через Apple будет удалена с этого устройства. Проекты и фотографии останутся на устройстве."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Apple 登录记录将从此设备中移除。你的项目和照片会保留在设备上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您使用此裝置登入的記錄。您的項目和照片保留在您的裝置上。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo record Accedi con Apple è stato rimosso da questo dispositivo. I tuoi progetti e le tue foto rimangono sul tuo dispositivo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uw aanmelding met Apple is van dit apparaat verwijderd. Uw projecten en foto's blijven op uw apparaat."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกการเข้าสู่ระบบด้วย Apple ของคุณถูกลบออกจากอุปกรณ์นี้ โปรเจกต์และรูปภาพของคุณยังคงอยู่ในอุปกรณ์ของคุณ"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catatan Masuk dengan Apple Anda dihapus dari perangkat ini. Proyek dan foto Anda tetap ada di perangkat Anda."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản ghi Đăng nhập bằng Apple của bạn đã được xóa khỏi thiết bị này. Dự án và ảnh của bạn vẫn còn trên thiết bị."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt Inloggning med Apple-postföringsinformations tas bort från denna enhet. Dina projekt och foton finns kvar på enheten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój zapis logowania przez Apple został usunięty z tego urządzenia. Twoje projekty i zdjęcia pozostają na urządzeniu."
          }
        }
      }
    },
    "Apple ile giriş ve iCloud hesabı ayrıdır. Eşitleme için bu cihazın Ayarlar uygulamasında aynı iCloud hesabı açık olmalı." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسجيل الدخول باستخدام Apple وحساب iCloud منفصلان. للمزامنة، يجب تسجيل هذا الجهاز في حساب iCloud نفسه من تطبيق الإعدادات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Apple anmelden und das iCloud-Konto sind getrennt. Für die Synchronisierung muss dieses Gerät in den Einstellungen mit demselben iCloud-Konto angemeldet sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in with Apple and your iCloud account are separate. To sync, this device must be signed in to the same iCloud account in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iniciar sesión con Apple y la cuenta de iCloud son independientes. Para sincronizar, este dispositivo debe usar la misma cuenta de iCloud en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se connecter avec Apple et le compte iCloud sont distincts. Pour synchroniser, cet appareil doit utiliser le même compte iCloud dans Réglages."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple से साइन इन और iCloud खाता अलग हैं। सिंक के लिए इस डिवाइस की सेटिंग्स में वही iCloud खाता साइन इन होना चाहिए।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleでサインインとiCloudアカウントは別のものです。同期するには、このデバイスの設定で同じiCloudアカウントにサインインしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple로 로그인과 iCloud 계정은 별개입니다. 동기화하려면 이 기기의 설정에서 동일한 iCloud 계정으로 로그인해야 합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iniciar sessão com a Apple e a conta iCloud são separados. Para sincronizar, este dispositivo deve usar a mesma conta iCloud nos Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вход с Apple и учётная запись iCloud — разные вещи. Для синхронизации на устройстве должна быть выбрана та же учётная запись iCloud в Настройках."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 Apple 登录与 iCloud 帐户相互独立。要同步，此设备必须在“设置”中登录同一个 iCloud 帐户。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Apple 登錄，您的 iCloud 帳戶是獨立的。若要進行同步，此裝置必須在「設定」中登入相同 iCloud 帳戶。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accesso con Apple e il tuo account iCloud sono separati. Per eseguire la sincronizzazione, è necessario accedere a questo dispositivo con lo stesso account iCloud in Impostazioni."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aanmelden met Apple en uw iCloud-account zijn gescheiden. Om te synchroniseren, moet dit apparaat zijn aangemeld bij hetzelfde iCloud-account in Instellingen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเข้าสู่ระบบด้วย Apple และบัญชี iCloud ของคุณเป็นสิ่งที่แยกกัน ถ้าต้องการซิงค์ อุปกรณ์นี้ต้องเข้าสู่ระบบด้วยบัญชี iCloud เดียวกันใน การตั้งค่า"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masuk dengan Apple dan akun iCloud Anda terpisah. Untuk sinkronisasi, perangkat ini harus masuk ke akun iCloud yang sama di Pengaturan."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đăng nhập bằng Apple và tài khoản iCloud của bạn là riêng biệt. Để đồng bộ, thiết bị này phải đăng nhập vào cùng một tài khoản iCloud trong Cài đặt."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inloggning med Apple och ditt iCloud-konto är separata. För att synkronisera måste denna enhet vara inloggad på samma iCloud-konto i Inställningar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logowanie przez Apple i konto iCloud są oddzielne. Aby synchronizować, to urządzenie musi być zalogowane na tym samym koncie iCloud w Ustawieniach."
          }
        }
      }
    },
    "Arkadaşını davet et; aynı projeye ikiniz de kare ekleyin, önceki kareleri birlikte görün" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ادعُ صديقًا؛ يضيف كلاكما صورًا إلى المشروع نفسه وتشاهدان الصور السابقة معًا"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade Freunde ein; ihr fügt beide Bilder zum selben Projekt hinzu und seht alle bisherigen Bilder gemeinsam"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invite a friend; you both add frames to the same project and see all previous frames together"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invita a un amigo; ambos añadís fotos al mismo proyecto y veis juntos las fotos anteriores"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invite un ami ; vous ajoutez tous les deux des photos au même projet et voyez ensemble les photos précédentes"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोस्त को न्योता दें; दोनों एक ही प्रोजेक्ट में फ़ोटो जोड़ें और पिछली फ़ोटो साथ देखें"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "友だちを招待して、同じプロジェクトにふたりで写真を追加。これまでの写真もいっしょに見られます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "친구를 초대하세요. 둘 다 같은 프로젝트에 사진을 추가하고 이전 사진도 함께 볼 수 있어요"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convide um amigo; vocês dois adicionam fotos ao mesmo projeto e veem juntos as fotos anteriores"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пригласите друга: вы оба добавляете кадры в один проект и вместе видите все прошлые кадры"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "邀请朋友；你们都可以向同一项目添加照片，并一起查看之前的照片"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "邀請朋友；您都將幀添加到同一個項目中，並一起查看所有先前的幀"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invita un amico; entrambi aggiungete frame allo stesso progetto e vedete insieme tutti i frame precedenti"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nodig een vriend uit; jullie voegen beiden frames toe aan hetzelfde project en zien samen alle eerdere frames"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เชิญเพื่อน; ทั้งสองคนเพิ่มกรอบไปยังโปรเจกต์เดียวกันและเห็นกรอบทั้งหมดก่อนหน้านี้ด้วยกัน"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajak teman; kalian berdua menambahkan bingkai ke proyek yang sama dan melihat semua bingkai sebelumnya bersama-sama"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mời một người bạn; cả hai bạn thêm khung vào cùng một dự án và xem tất cả các khung trước đó cùng nhau"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bjud in en vän; ni båda lägger till ramar i samma projekt och ser alla tidigare ramar tillsammans"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaproś znajomego; oboje dodajecie ramki do tego samego projektu i widzicie wszystkie wcześniejsze ramki razem"
          }
        }
      }
    },
    "Arşiv dosyası okunamadı ya da bozuk." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت قراءة ملف الأرشيف أو أنه تالف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Archivdatei konnte nicht gelesen werden oder ist beschädigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The archive file could not be read or is corrupted."
          }
        },
        "es" : {
