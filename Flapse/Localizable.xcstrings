    "Karşılaştığın bir sorunu ya da eklenmesini istediğin bir şeyi doğrudan bana yazabilirsin." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك مراسلتي مباشرة بشأن مشكلة أو طلب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst mir direkt über ein Problem oder einen Wunsch schreiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can write to me directly about a problem you hit or something you’d like added."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes escribirme directamente sobre un problema o algo que quieras añadir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez m’écrire directement pour un problème ou une demande."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप मुझे सीधे किसी समस्या या सुझाव के बारे में लिख सकते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "問題やご要望を直接お書きください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "문제나 원하는 기능을 저에게 바로 알려 주세요."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode me escrever diretamente sobre um problema ou algo que gostaria de ver."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете написать мне напрямую о проблеме или пожелании."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karşılaştığın bir sorunu ya da eklenmesini istediğin bir şeyi doğrudan bana yazabilirsin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以直接告诉我遇到的问题或想要的功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以直接寫信告訴我您遇到的問題或您想要添加的內容。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi scrivermi direttamente su un problema che hai riscontrato o su qualcosa che desideri venga aggiunto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt me rechtstreeks schrijven over een probleem dat je bent tegengekomen of iets dat je toegevoegd zou willen zien."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณสามารถเขียนถึงฉันโดยตรงเกี่ยวกับปัญหาที่คุณพบหรือสิ่งที่คุณอยากให้เพิ่ม"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda dapat menulis langsung kepada saya tentang masalah yang Anda temui atau sesuatu yang ingin Anda tambahkan."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thể viết trực tiếp cho tôi về một vấn đề bạn gặp phải hoặc điều gì đó bạn muốn thêm vào."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan skriva direkt till mig om ett problem du stöter på eller något du vill ha tillagt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz napisać do mnie bezpośrednio o problemie, na który natrafiłeś, lub o czymś, co chciałbyś dodać."
          }
        }
      }
    },
