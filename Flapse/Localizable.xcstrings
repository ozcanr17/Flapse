    "Birincil renk arka planı; ikincil renk butonları, seçimleri ve vurguları belirler." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اللون الأساسي يحدد الخلفية، واللون الثانوي يحدد الأزرار والتحديدات والتمييزات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Primärfarbe bestimmt den Hintergrund, die Sekundärfarbe die Buttons, Auswahlen und Hervorhebungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The primary color sets the background; the secondary color defines buttons, selections and highlights."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El color principal define el fondo; el secundario, los botones, las selecciones y los resaltados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La couleur principale définit l'arrière-plan ; la couleur secondaire définit les boutons, les sélections et les accents."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्राथमिक रंग पृष्ठभूमि तय करता है; द्वितीयक रंग बटन, चयन और हाइलाइट तय करता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メインカラーは背景を、サブカラーはボタン・選択・ハイライトを決めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본 색상은 배경을, 보조 색상은 버튼과 선택 항목, 강조를 결정합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cor principal define o fundo; a secundária define botões, seleções e destaques."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Основной цвет задаёт фон, дополнительный — кнопки, выделения и акценты."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主色决定背景，辅色决定按钮、选中项和高亮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原色設定背景；輔助色彩定義按鈕、選擇和反白。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il colore primario imposta lo sfondo; il colore secondario definisce pulsanti, selezioni ed evidenziazioni."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De primaire kleur stelt de achtergrond in; de secundaire kleur bepaalt knoppen, selecties en markeringen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สีหลักกำหนดพื้นหลัง; สีรองกำหนดปุ่ม การเลือก และการเน้น"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warna utama menetapkan latar belakang; warna sekunder menentukan tombol, pilihan, dan sorotan."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Màu chính xác định nền; màu phụ xác định nút, lựa chọn và điểm nổi bật."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primärfärgen anger bakgrunden; sekundärfärgen definierar knappar, markeringar och höjdpunkter."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolor podstawowy ustawia tło; kolor wtórny definiuje przyciski, zaznaczenia i podświetlenia."
          }
        }
      }
    },
